{:paths ["src"]
 :deps {io.github.kotoba-lang/langgraph
        {:git/sha "a332a770a0d2b5193f81b54483bb954fb29ef8d7"}
        ;; the settlement amount is recomputed from the entity's own filed
        ;; rate plan rather than read out of the advisor's proposal.
        io.github.kotoba-lang/reservation
        {:git/sha "c27ee70434be8db34390f7de12e8294a15dac100"}}
 :aliases
 {:dev {:override-deps
        {io.github.kotoba-lang/langgraph
         {:local/root "../../kotoba-lang/langgraph"}
         io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  :run {:main-opts ["-m" "touroperatorops.sim"]}
  ;; clojure -M:dev:render-html [out-file]
  ;;   -> regenerate docs/samples/operator-console.html by running the REAL
  ;;      actor stack (operation -> governor -> store). Flagship checklist
  ;;      item 2. jp-go-digital-design-system (DADS) is the workspace's base
  ;;      design system and is needed only for this build-time page, so it is
  ;;      an alias-local extra-dep rather than a runtime dep of the actor.
  :render-html {:extra-deps {io.github.kotoba-lang/jp-go-digital-design-system
                             {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
                              :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
                :main-opts ["-m" "touroperatorops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
